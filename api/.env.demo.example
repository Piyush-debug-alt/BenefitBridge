DEMO_MONGODB_URI=mongodb://127.0.0.1:27017
DEMO_PORT=4001
DEMO_APP_ORIGIN=http://127.0.0.1:5174
# Enable only when a local reverse proxy overwrites X-Forwarded-For with the client IP.
# DEMO_TRUST_LOOPBACK_PROXY=false
# Optional. Fill both Google values in your ignored .env.demo.
DEMO_GOOGLE_CLIENT_ID=
DEMO_GOOGLE_CLIENT_SECRET=
# Optional. Example local mail sandbox connection: smtp://127.0.0.1:1025
DEMO_SMTP_URL=
DEMO_MAIL_FROM=
# Optional absolute path to an alternate synthetic snapshot.
# DEMO_INGEST_SOURCE_FILE=
# DEMO_AI_EXTRACTION_PROVIDER=off
# Gemini is opt-in. Use a key from a verified Free project.
# DEMO_GEMINI_FREE_TIER_CONFIRMED=false
# DEMO_GEMINI_API_KEY=
# DEMO_GEMINI_MODEL=gemini-3.1-flash-lite
# DEMO_GEMINI_DAILY_REQUEST_LIMIT=10
