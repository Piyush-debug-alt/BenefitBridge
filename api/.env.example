MONGODB_DATABASE=benefitbridge_dev
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# Optional. Fill both Google values in your ignored .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Example local mail sandbox connection: smtp://127.0.0.1:1025
SMTP_URL=
MAIL_FROM=
