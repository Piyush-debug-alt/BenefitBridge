{
  "name": "@benefitbridge/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node --watch --env-file-if-exists=.env.demo src/server.js --demo",
    "seed:demo": "node --env-file-if-exists=.env.demo src/modules/ingestion/cli.js --demo",
    "seed:authorized": "node --env-file-if-exists=.env src/modules/ingestion/cli.js",
    "notifications": "node --env-file-if-exists=.env src/modules/notifications/worker-cli.js",
    "notifications:demo": "node --env-file-if-exists=.env.demo src/modules/notifications/worker-cli.js --demo",
    "publish:demo": "node --env-file-if-exists=.env.demo src/modules/notifications/demo-cli.js",
    "sync": "node --env-file-if-exists=.env src/modules/ingestion/worker-cli.js",
    "sync:demo": "node --env-file-if-exists=.env.demo src/modules/ingestion/worker-cli.js --demo",
    "test": "vitest run --testTimeout=15000 --hookTimeout=120000"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "argon2": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^10.3.0",
    "supertest": "^7.1.0",
    "vitest": "5.1.1"
  }
}
