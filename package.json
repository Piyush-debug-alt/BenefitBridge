{
  "name": "benefitbridge",
  "private": true,
  "workspaces": ["api", "web"],
  "engines": { "node": "^22.12.0 || >=24" },
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "demo:api": "npm run demo -w api",
    "demo:web": "npm run demo -w web",
    "seed:demo": "npm run seed:demo -w api",
    "seed:authorized": "npm run seed:authorized -w api --",
    "notifications": "npm run notifications -w api --",
    "notifications:demo": "npm run notifications:demo -w api --",
    "publish:demo": "npm run publish:demo -w api --",
    "sync": "npm run sync -w api --",
    "sync:demo": "npm run sync:demo -w api --",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate:extraction": "node scripts/evaluate-extraction.mjs",
    "test": "npm test --workspaces",
    "build": "npm run build -w web"
  }
}
